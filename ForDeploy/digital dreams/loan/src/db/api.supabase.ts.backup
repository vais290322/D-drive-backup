import { supabase } from "./supabase";
import type {
  Profile,
  Customer,
  Product,
  Loan,
  EmiPayment,
  Penalty,
  LoanWithDetails,
  DashboardStats,
  LoanLedger,
} from "@/types/types";

export const api = {
  auth: {
    getCurrentUser: async () => {
      const { data: { user }, error } = await supabase.auth.getUser();
      if (error) throw error;
      return user;
    },

    getProfile: async (userId: string): Promise<Profile | null> => {
      const { data, error } = await supabase
        .from("profiles")
        .select("*")
        .eq("id", userId)
        .maybeSingle();
      
      if (error) throw error;
      return data;
    },

    signOut: async () => {
      const { error } = await supabase.auth.signOut();
      if (error) throw error;
    },
  },

  profiles: {
    getAll: async (): Promise<Profile[]> => {
      const { data, error } = await supabase
        .from("profiles")
        .select("*")
        .order("created_at", { ascending: false });
      
      if (error) throw error;
      return Array.isArray(data) ? data : [];
    },

    updateRole: async (userId: string, role: string): Promise<void> => {
      const { error } = await supabase
        .from("profiles")
        .update({ role })
        .eq("id", userId);
      
      if (error) throw error;
    },

    updateProfile: async (userId: string, updates: Partial<Profile>): Promise<void> => {
      const { error } = await supabase
        .from("profiles")
        .update(updates)
        .eq("id", userId);
      
      if (error) throw error;
    },
  },

  customers: {
    getAll: async (search?: string): Promise<Customer[]> => {
      let query = supabase
        .from("customers")
        .select("*")
        .order("created_at", { ascending: false });

      if (search) {
        query = query.or(`full_name.ilike.%${search}%,mobile_primary.ilike.%${search}%,customer_code.ilike.%${search}%`);
      }

      const { data, error } = await query;
      if (error) throw error;
      return Array.isArray(data) ? data : [];
    },

    getById: async (id: string): Promise<Customer | null> => {
      const { data, error } = await supabase
        .from("customers")
        .select("*")
        .eq("id", id)
        .maybeSingle();
      
      if (error) throw error;
      return data;
    },

    create: async (customer: Partial<Customer>): Promise<Customer> => {
      const { data: codeData } = await supabase.rpc("generate_customer_code");
      const customerCode = codeData || `CUST${Date.now()}`;

      const { data: { user } } = await supabase.auth.getUser();

      const { data, error } = await supabase
        .from("customers")
        .insert({
          ...customer,
          customer_code: customerCode,
          created_by: user?.id,
        })
        .select()
        .single();
      
      if (error) throw error;
      return data;
    },

    update: async (id: string, updates: Partial<Customer>): Promise<void> => {
      const { error } = await supabase
        .from("customers")
        .update({
          ...updates,
          updated_at: new Date().toISOString(),
        })
        .eq("id", id);
      
      if (error) throw error;
    },

    delete: async (id: string): Promise<void> => {
      const { error } = await supabase
        .from("customers")
        .delete()
        .eq("id", id);
      
      if (error) throw error;
    },

    verifyKyc: async (id: string, status: string, remarks?: string): Promise<void> => {
      const { data: { user } } = await supabase.auth.getUser();

      const { error } = await supabase
        .from("customers")
        .update({
          kyc_status: status,
          kyc_verified_by: user?.id,
          kyc_verified_at: new Date().toISOString(),
          kyc_remarks: remarks,
          updated_at: new Date().toISOString(),
        })
        .eq("id", id);
      
      if (error) throw error;
    },

    search: async (query: string): Promise<Customer[]> => {
      const { data, error } = await supabase
        .from("customers")
        .select("*")
        .or(`full_name.ilike.%${query}%,mobile_primary.ilike.%${query}%,customer_code.ilike.%${query}%,email.ilike.%${query}%`)
        .order("created_at", { ascending: false })
        .limit(10);
      
      if (error) throw error;
      return Array.isArray(data) ? data : [];
    },
  },

  products: {
    getAll: async (search?: string): Promise<Product[]> => {
      let query = supabase
        .from("products")
        .select("*")
        .order("created_at", { ascending: false });

      if (search) {
        query = query.or(`brand.ilike.%${search}%,model.ilike.%${search}%,product_code.ilike.%${search}%,imei_1.ilike.%${search}%`);
      }

      const { data, error } = await query;
      if (error) throw error;
      return Array.isArray(data) ? data : [];
    },

    getAvailable: async (): Promise<Product[]> => {
      const { data, error } = await supabase
        .from("products")
        .select("*")
        .eq("status", "available")
        .order("created_at", { ascending: false });
      
      if (error) throw error;
      return Array.isArray(data) ? data : [];
    },

    getById: async (id: string): Promise<Product | null> => {
      const { data, error } = await supabase
        .from("products")
        .select("*")
        .eq("id", id)
        .maybeSingle();
      
      if (error) throw error;
      return data;
    },

    create: async (product: Partial<Product>): Promise<Product> => {
      const { data: codeData } = await supabase.rpc("generate_product_code");
      const productCode = codeData || `PROD${Date.now()}`;

      const { data: { user } } = await supabase.auth.getUser();

      const { data, error } = await supabase
        .from("products")
        .insert({
          ...product,
          product_code: productCode,
          created_by: user?.id,
        })
        .select()
        .single();
      
      if (error) throw error;
      return data;
    },

    update: async (id: string, updates: Partial<Product>): Promise<void> => {
      const { error } = await supabase
        .from("products")
        .update({
          ...updates,
          updated_at: new Date().toISOString(),
        })
        .eq("id", id);
      
      if (error) throw error;
    },

    delete: async (id: string): Promise<void> => {
      const { error } = await supabase
        .from("products")
        .delete()
        .eq("id", id);
      
      if (error) throw error;
    },

    search: async (query: string): Promise<Product[]> => {
      const { data, error } = await supabase
        .from("products")
        .select("*")
        .or(`brand.ilike.%${query}%,model.ilike.%${query}%,product_code.ilike.%${query}%,imei_1.ilike.%${query}%,serial_number.ilike.%${query}%`)
        .order("created_at", { ascending: false })
        .limit(10);
      
      if (error) throw error;
      return Array.isArray(data) ? data : [];
    },
  },

  loans: {
    getAll: async (filters?: { status?: string; customer_id?: string }): Promise<LoanWithDetails[]> => {
      let query = supabase
        .from("loans")
        .select(`
          *,
          customer:customers(*),
          product:products(*)
        `)
        .order("created_at", { ascending: false });

      if (filters?.status) {
        query = query.eq("status", filters.status);
      }

      if (filters?.customer_id) {
        query = query.eq("customer_id", filters.customer_id);
      }

      const { data, error } = await query;
      if (error) throw error;
      return Array.isArray(data) ? data : [];
    },

    getById: async (id: string): Promise<LoanWithDetails | null> => {
      const { data, error } = await supabase
        .from("loans")
        .select(`
          *,
          customer:customers(*),
          product:products(*),
          payments:emi_payments(*),
          penalties:penalties(*)
        `)
        .eq("id", id)
        .maybeSingle();
      
      if (error) throw error;
      return data;
    },

    create: async (loan: Partial<Loan>): Promise<Loan> => {
      const { data: loanIdData } = await supabase.rpc("generate_loan_id");
      const loanId = loanIdData || `LOAN${Date.now()}`;

      const { data: { user } } = await supabase.auth.getUser();

      const { data, error } = await supabase
        .from("loans")
        .insert({
          ...loan,
          loan_id: loanId,
          created_by: user?.id,
        })
        .select()
        .single();
      
      if (error) throw error;

      if (loan.product_id) {
        await supabase
          .from("products")
          .update({ status: "assigned" })
          .eq("id", loan.product_id);
      }

      return data;
    },

    update: async (id: string, updates: Partial<Loan>): Promise<void> => {
      const { error } = await supabase
        .from("loans")
        .update({
          ...updates,
          updated_at: new Date().toISOString(),
        })
        .eq("id", id);
      
      if (error) throw error;
    },

    delete: async (id: string): Promise<void> => {
      const loan = await api.loans.getById(id);
      
      if (loan?.product_id) {
        await supabase
          .from("products")
          .update({ status: "available" })
          .eq("id", loan.product_id);
      }

      const { error } = await supabase
        .from("loans")
        .delete()
        .eq("id", id);
      
      if (error) throw error;
    },

    getLedger: async (loanId: string): Promise<LoanLedger | null> => {
      const loan = await api.loans.getById(loanId);
      if (!loan) return null;

      const payments = loan.payments || [];
      const penalties = loan.penalties || [];

      const totalPaid = payments.reduce((sum, p) => sum + Number(p.amount_paid), 0);
      const totalPenalties = penalties.reduce((sum, p) => sum + Number(p.amount), 0);

      return {
        loan,
        principal: Number(loan.principal_amount),
        interest: Number(loan.total_interest),
        processing_fee: Number(loan.processing_fee),
        insurance_fee: Number(loan.insurance_fee),
        total_penalties: totalPenalties,
        total_payable: Number(loan.total_payable) + totalPenalties,
        total_paid: totalPaid,
        total_outstanding: Number(loan.total_payable) + totalPenalties - totalPaid,
        payment_history: payments,
        penalty_history: penalties,
      };
    },

    search: async (query: string): Promise<LoanWithDetails[]> => {
      const { data, error } = await supabase
        .from("loans")
        .select(`
          *,
          customer:customers(*),
          product:products(*)
        `)
        .or(`loan_id.ilike.%${query}%`)
        .order("created_at", { ascending: false })
        .limit(10);
      
      if (error) throw error;
      return Array.isArray(data) ? data : [];
    },
  },

  payments: {
    create: async (payment: Partial<EmiPayment>): Promise<EmiPayment> => {
      const { data: { user } } = await supabase.auth.getUser();

      const { data, error } = await supabase
        .from("emi_payments")
        .insert({
          ...payment,
          collected_by: user?.id,
        })
        .select()
        .single();
      
      if (error) throw error;
      return data;
    },

    getByLoan: async (loanId: string): Promise<EmiPayment[]> => {
      const { data, error } = await supabase
        .from("emi_payments")
        .select("*")
        .eq("loan_id", loanId)
        .order("payment_date", { ascending: false });
      
      if (error) throw error;
      return Array.isArray(data) ? data : [];
    },
  },

  penalties: {
    create: async (penalty: Partial<Penalty>): Promise<Penalty> => {
      const { data: { user } } = await supabase.auth.getUser();

      const { data, error } = await supabase
        .from("penalties")
        .insert({
          ...penalty,
          applied_by: user?.id,
        })
        .select()
        .single();
      
      if (error) throw error;
      return data;
    },

    getByLoan: async (loanId: string): Promise<Penalty[]> => {
      const { data, error } = await supabase
        .from("penalties")
        .select("*")
        .eq("loan_id", loanId)
        .order("applied_at", { ascending: false });
      
      if (error) throw error;
      return Array.isArray(data) ? data : [];
    },

    delete: async (id: string): Promise<void> => {
      const { error } = await supabase
        .from("penalties")
        .delete()
        .eq("id", id);
      
      if (error) throw error;
    },
  },

  dashboard: {
    getStats: async (): Promise<DashboardStats> => {
      const [customers, loans, payments] = await Promise.all([
        supabase.from("customers").select("id", { count: "exact", head: true }),
        supabase.from("loans").select("*"),
        supabase.from("emi_payments").select("*"),
      ]);

      const allLoans = Array.isArray(loans.data) ? loans.data : [];
      const allPayments = Array.isArray(payments.data) ? payments.data : [];

      const activeLoans = allLoans.filter(l => l.status === "active");
      const completedLoans = allLoans.filter(l => l.status === "completed");

      const today = new Date().toISOString().split("T")[0];
      const todayPayments = allPayments.filter(p => p.payment_date === today);
      const totalCollectionToday = todayPayments.reduce((sum, p) => sum + Number(p.amount_paid), 0);

      const totalDisbursed = allLoans.reduce((sum, l) => sum + Number(l.principal_amount), 0);
      const totalPaid = allPayments.reduce((sum, p) => sum + Number(p.amount_paid), 0);
      const totalPayable = allLoans
        .filter(l => l.status === "active")
        .reduce((sum, l) => sum + Number(l.total_payable), 0);

      return {
        total_customers: customers.count || 0,
        active_loans: activeLoans.length,
        completed_loans: completedLoans.length,
        delayed_emis: 0,
        total_collection_today: totalCollectionToday,
        total_outstanding: totalPayable - totalPaid,
        total_disbursed: totalDisbursed,
      };
    },
  },

  storage: {
    uploadFile: async (bucket: string, path: string, file: File): Promise<string> => {
      const fileExt = file.name.split(".").pop();
      const fileName = `${Date.now()}_${Math.random().toString(36).substring(7)}.${fileExt}`;
      const filePath = `${path}/${fileName}`;

      const { error } = await supabase.storage
        .from(bucket)
        .upload(filePath, file);

      if (error) throw error;

      const { data } = supabase.storage
        .from(bucket)
        .getPublicUrl(filePath);

      return data.publicUrl;
    },

    deleteFile: async (bucket: string, path: string): Promise<void> => {
      const { error } = await supabase.storage
        .from(bucket)
        .remove([path]);

      if (error) throw error;
    },
  },
};
