{
  "name": "maquam-holidays-server",
  "version": "1.0.0",
  "description": "MongoDB + Express backend for Maquam Holidays",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "ts-node src/utils/seed.ts",
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "express",
    "mongodb",
    "typescript",
    "travel",
    "booking"
  ],
  "author": "Maquam Holidays",
  "license": "MIT",
  "dependencies": {
